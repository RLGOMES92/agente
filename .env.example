# Claude API
ANTHROPIC_API_KEY=cole-sua-chave-aqui
MODEL=claude-sonnet-5-5

# Servidor
PORT=3000
DB_PATH=./agente.db

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v26.0
VERIFY_TOKEN=crie-um-token-aleatorio
APP_SECRET=segredo-do-app-da-meta

# Um token por empresa (nome definido em companies/<empresa>.json -> token_env)
WA_TOKEN_DAPAZ=cole-o-token-permanente-da-meta
TEAM_NUMBER_DAPAZ=numero-da-equipe-com-DDI-e-DDD-somente-digitos
ADMIN_TOKEN=crie-uma-senha-forte-para-a-rota-admin
